    """Check if a directory is actually a piledriver session directory.

    Distinguishes piledriver directories from git repos that happen to be
    named '.piledriver/' by checking for session indicators.
    """
    if not path.exists() or not path.is_dir():
        return False

    # If it's a git repo, it's not a piledriver directory
    if (path / ".git").exists():
        return False

    # Check for session indicators: subdirs with state.json
    try:
        for item in path.iterdir():
            if item.is_dir() and (item / "state.json").exists():
                return True
    except PermissionError:
        pass

    # Empty piledriver dir is still valid (newly created)
    # But only if parent has .git (it's in a repo)
    parent = path.parent
    if (parent / ".git").exists():
        return True

    return False


def get_piledriver_root() -> Path:
    """Find the .piledriver directory, searching upward from cwd.

    For new projects, creates in the git repo root (not cwd).
    """
    cwd = Path.cwd()
    for parent in [cwd] + list(cwd.parents):
        piledriver_path = parent / PILEDRIVER_DIR
        if is_piledriver_dir(piledriver_path):
            return piledriver_path

    # No existing dir found - default to repo root (or cwd if not in a repo)
    repo_root = find_repo_root()
    if repo_root:
        return repo_root / PILEDRIVER_DIR
    return cwd / PILEDRIVER_DIR


def validate_session_name(name: str) -> tuple:
    """Validate session name. Returns (valid: bool, error: str)."""
    if not name:
        return False, "Session name cannot be empty"
    if name != name.lower():
        return False, f"Session name must be lowercase (got '{name}', try '{name.lower()}')"
    if not name[0].isalpha():
        return False, "Session name must start with a letter"
    if not all(c.isalnum() or c in '-_' for c in name):
        return False, "Session name can only contain letters, numbers, hyphens, and underscores"
    return True, ""


def get_default_session() -> str | None:
    """Get default session name if exactly one session exists."""
    piledriver_dir = get_piledriver_root()
    if not piledriver_dir.exists():
        return None

    sessions = [
        d.name for d in piledriver_dir.iterdir()
        if d.is_dir() and not d.name.startswith(".") and (d / "state.json").exists()
    ]

    if len(sessions) == 1:
        return sessions[0]
    return None


def resolve_session(session_name: str | None, command: str) -> str | None:
    """Resolve session name, using default if not provided. Returns None on error (after printing)."""
    if session_name:
        return session_name

    default = get_default_session()
    if default:
        return default

    # No default available - print helpful error
    piledriver_dir = get_piledriver_root()
    if not piledriver_dir.exists():
        print(f"Error: No piledriver directory found.")
        print(f"Run 'piledriver init <session_name>' to start.")
    else:
        sessions = [
            d.name for d in piledriver_dir.iterdir()
            if d.is_dir() and not d.name.startswith(".")
        ]
        if not sessions:
            print(f"Error: No sessions found.")
            print(f"Run 'piledriver init <session_name>' to start.")
        else:
            print(f"Error: Multiple sessions exist. Specify one:")
            for s in sorted(sessions):
                print(f"  piledriver {command} {s}")
    return None


def add_to_git_exclude(piledriver_dir: Path):
    """Add piledriver directory to .git/info/exclude if not already present."""
    git_dir = piledriver_dir.parent / ".git"
    if not git_dir.exists():
        return  # Not a git repo

    exclude_file = git_dir / "info" / "exclude"
    exclude_file.parent.mkdir(parents=True, exist_ok=True)

    dir_name = piledriver_dir.name
    exclude_entry = f"{dir_name}/"

    # Check if already excluded
    if exclude_file.exists():
        content = exclude_file.read_text()
        if exclude_entry in content.splitlines():
            return  # Already excluded

    # Append to exclude file
    with open(exclude_file, "a") as f:
        f.write(f"\n# Piledriver session data (local only)\n{exclude_entry}\n")


def cmd_init(args):
    """Initialize a new analysis session."""
    session_name = args.session_name
    skip_recon = getattr(args, 'skip_recon', False)

    # Validate session name
    valid, error = validate_session_name(session_name)
    if not valid:
        print(f"Error: {error}")
        return 1

    piledriver_dir = get_piledriver_root()

    session_dir = piledriver_dir / session_name

    if session_dir.exists():
        print(f"Error: Session '{session_name}' already exists at {session_dir}")
        return 1

    # Determine initial phase
    initial_phase = "SCOPING" if skip_recon else "RECONNAISSANCE"

    # Create directories
    session_dir.mkdir(parents=True)

    # Add to .git/info/exclude (keeps piledriver/ out of version control)
    add_to_git_exclude(piledriver_dir)

    # Create state.json
    state = create_initial_state(session_name, initial_phase)
    write_state(session_dir, state)

    # Create placeholder files
    (session_dir / "reconnaissance.md").write_text(
        RECONNAISSANCE_TEMPLATE.format(session_name=session_name)
    )
    (session_dir / "boundary.md").write_text(
        BOUNDARY_TEMPLATE.format(session_name=session_name)
    )
    (session_dir / "assumptions.md").write_text(ASSUMPTIONS_TEMPLATE)

    # Convert session name to valid TLA+ module name (PascalCase, no hyphens)
    module_name = "".join(word.capitalize() for word in session_name.replace("-", "_").split("_"))
    (session_dir / "model.tla").write_text(
        MODEL_TLA_TEMPLATE.format(module_name=module_name)
    )
    (session_dir / "probe.md").write_text(PROBE_TEMPLATE)

    print(f"Created session '{session_name}' at {session_dir}")
    print(f"  - state.json (phase: {initial_phase})")
    print(f"  - reconnaissance.md")
    print(f"  - boundary.md")
    print(f"  - assumptions.md")
    print(f"  - model.tla")
    print(f"  - probe.md")

    # Print guidance
    guidance_key = "init:scoping" if skip_recon else "init"
    print(format_guidance(guidance_key, session=session_name, phase=initial_phase))

    return 0


def cmd_bug(args):
    """Create a bug reproducer scaffold."""
    session_name = args.session_name
    bug_name = args.bug_name

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

