def format_guidance(template_key: str, **kwargs) -> str:
    """Format guidance output for a command."""
    template = GUIDANCE.get(template_key, {})
    if not template:
        return ""

    lines = []

    # Summary
    summary = template.get("summary", "").format(**kwargs)
    if summary:
        lines.append(f"\n{summary}")
        lines.append("")

    # Next steps
    steps = template.get("next_steps", [])
    if steps:
        lines.append("Next steps:")
        for step in steps:
            formatted = step.format(**kwargs)
            lines.append(f"  {formatted}")
        lines.append("")

    # Reminder
    reminder = template.get("reminder", "").format(**kwargs)
    if reminder:
        lines.append(f"Note: {reminder}")

    return "\n".join(lines)


def find_repo_root() -> Optional[Path]:
    """Find the git repository root by searching upward from cwd.

    Returns the directory containing .git, or None if not in a git repo.
    """
    cwd = Path.cwd()
    for parent in [cwd] + list(cwd.parents):
        if (parent / ".git").exists():
            return parent
    return None


