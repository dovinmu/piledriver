# === State file management ===

def read_state(session_dir: Path) -> Optional[dict]:
    """Read state.json from a session directory, with file locking."""
    state_file = session_dir / "state.json"
    if not state_file.exists():
        return None

    lock_file = session_dir / "state.json.lock"
    with open(lock_file, "w") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_SH)  # Shared lock for reading
        try:
            with open(state_file) as f:
                return json.load(f)
        except json.JSONDecodeError:
            return None
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def write_state(session_dir: Path, state: dict) -> None:
    """Write state.json to a session directory, with file locking."""
    state_file = session_dir / "state.json"
    lock_file = session_dir / "state.json.lock"

    state["last_modified"] = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')

    with open(lock_file, "w") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)  # Exclusive lock for writing
        try:
            with open(state_file, "w") as f:
                json.dump(state, f, indent=2)
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def create_initial_state(session_name: str, initial_phase: str = "RECONNAISSANCE") -> dict:
    """Create a new state dictionary for a session."""
    now = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
    return {
        "session": session_name,
        "current_phase": initial_phase,
        "phase_history": [
            {"phase": initial_phase, "entered": now}
        ],
        "phase_notes": {},
        "verification_technique": None,  # Set during VERIFICATION phase
        "technique_reasoning": None,
        "created": now,
        "last_modified": now
    }


def transition_phase(session_dir: Path, new_phase: str) -> bool:
    """Transition to a new phase. Returns True on success."""
    if new_phase not in PHASES:
        return False

    state = read_state(session_dir)
    if state is None:
        return False

    old_phase = state.get("current_phase", "")

    # Clean up _tlc_out when leaving VERIFICATION (can be huge)
    if old_phase == "VERIFICATION" and new_phase != "VERIFICATION":
        tlc_out = session_dir / "_tlc_out"
        if tlc_out.exists():
            try:
                shutil.rmtree(tlc_out)
                print(f"Cleaned up _tlc_out directory")
            except Exception as e:
                print(f"Warning: Could not clean up _tlc_out: {e}")

    state["current_phase"] = new_phase
    state["phase_history"].append({
        "phase": new_phase,
        "entered": datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
    })

    write_state(session_dir, state)
    return True

# === Config file management ===

def load_config(piledriver_dir: Path) -> dict:
    """Load config.yaml from piledriver directory."""
    config_file = piledriver_dir / "config.yaml"
    config = {
        "critic_command": DEFAULT_CRITIC_COMMAND,
    }

    if not config_file.exists():
        return config

    try:
        content = config_file.read_text()
        for line in content.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if ":" in stripped:
                key, _, value = stripped.partition(":")
                key = key.strip()
                value = value.strip().strip('"').strip("'")
                if key in config:
                    config[key] = value
    except Exception:
        pass  # Use defaults on error

    return config


def save_config(piledriver_dir: Path, config: dict) -> None:
    """Save config.yaml to piledriver directory."""
    config_file = piledriver_dir / "config.yaml"
    lines = ["# Piledriver configuration"]
    for key, value in config.items():
        lines.append(f'{key}: "{value}"')
    config_file.write_text("\n".join(lines) + "\n")


# === Critic log management ===

def append_critic_log(session_dir: Path, phase: str, worker_message: str, critic_response: str) -> None:
    """Append a critic exchange to the session's critic log."""
    log_file = session_dir / "critic_log.jsonl"
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z'),
        "phase": phase,
        "worker_message": worker_message,
        "critic_response": critic_response,
    }
    with open(log_file, "a") as f:
        f.write(json.dumps(entry) + "\n")


# === Phase validation ===

def is_file_filled(path: Path, template_marker: str = "<!--") -> bool:
    """Check if a file has been filled beyond the template."""
    if not path.exists():
        return False
    content = path.read_text()
    # Remove HTML comments (template instructions)
    lines = content.split("\n")
    content_lines = []
    in_comment = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("<!--"):
            in_comment = True
        if not in_comment and stripped and not stripped.startswith("#") and not stripped.startswith("|"):
            # Skip table separators too
            if not stripped.startswith("-"):
                content_lines.append(line)
        if "-->" in stripped:
            in_comment = False
    # Check for meaningful content beyond headers and empty bullets
    meaningful = [l for l in content_lines if l.strip() and l.strip() != "-"]
    return len(meaningful) > 0


def validate_phase_transition(session_dir: Path, current_phase: str, new_phase: str) -> tuple:
    """
    Validate a phase transition.
    Returns (allowed: bool, reason: str).

    Phase transitions are flexible:
    - Forward: Must satisfy file requirements
    - Backward: Always allowed (model may need to revisit earlier phases)
    - Skip from RECONNAISSANCE to SCOPING: Allowed (recon is optional)
    """
    if new_phase not in PHASES:
        return False, f"Invalid phase: {new_phase}"

    try:
        current_idx = PHASES.index(current_phase)
        new_idx = PHASES.index(new_phase)
    except ValueError:
        return False, f"Invalid phase: {current_phase} or {new_phase}"

    # Backward transitions are always allowed (model may need to revisit)
    if new_idx < current_idx:
        return True, f"Going back to {new_phase} (revisiting earlier phase)"

    # Same phase
    if new_idx == current_idx:
        return True, f"Already in {new_phase}"

    # Skip from RECONNAISSANCE to SCOPING is allowed (recon is optional)
    if current_phase == "RECONNAISSANCE" and new_phase == "SCOPING":
        return True, "Skipping reconnaissance (optional phase)"

    # Forward transitions with requirements
    if current_phase == "RECONNAISSANCE" and new_phase == "ASSUMPTIONS":
        # Must go through SCOPING first
        return False, "Must complete SCOPING before ASSUMPTIONS"

    if current_phase == "SCOPING" and new_phase == "ASSUMPTIONS":
        if is_file_filled(session_dir / "boundary.md"):
            return True, "boundary.md has content"
        return False, "boundary.md must be filled before advancing"

    if current_phase == "ASSUMPTIONS" and new_phase == "VERIFICATION":
        if is_file_filled(session_dir / "assumptions.md"):
            return True, "assumptions.md has content"
        return False, "assumptions.md must be filled before advancing"

    if current_phase == "VERIFICATION" and new_phase == "REPORT":
        # Check for any verification artifact (TLA+, properties, fuzz plan, etc.)
        verification_files = [
            session_dir / "model.tla",
            session_dir / "properties.md",
            session_dir / "fuzz_plan.md",
            session_dir / "diff_test.md",
            session_dir / "review_checklist.md",
        ]
        for vf in verification_files:
            if vf.exists() and is_file_filled(vf, "\\*" if vf.suffix == ".tla" else "<!--"):
                return True, f"{vf.name} has content"
        return False, "A verification artifact must be filled before advancing (model.tla, properties.md, etc.)"

    # Cannot skip phases (except RECON -> SCOPING)
    if new_idx > current_idx + 1:
        return False, f"Cannot skip phases. Current: {current_phase}, requested: {new_phase}"

    return False, f"Invalid transition from {current_phase} to {new_phase}"


