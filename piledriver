BUG_RUNSH_TEMPLATE = """#!/bin/bash
set -e

# === REPRODUCER RULES ===
# 1. SINGLE TEST: This reproducer should test ONE specific bug
# 2. COMMIT-FIRST: BASE_COMMIT and FIX_COMMIT must be set BEFORE running
# 3. NO DIRECT IMPORTS: Test the installed code, not patched copies
# 4. SAME TEST: The same test must FAIL on base and PASS on fix
#
# Success = tests FAIL on BASE_COMMIT, PASS on FIX_COMMIT

# === CONFIGURATION ===
# YOU MUST SET THESE VALUES before running piledriver test:
REPO_PATH="../../../<target-repo>"  # Path to repo under scrutiny
BASE_COMMIT="<commit-sha>"          # Commit where bug EXISTS (tests should FAIL)
FIX_COMMIT="<commit-sha>"           # Commit with fix APPLIED (tests should PASS)
TEST_CMD="go test -v ./path/to/tests/..."  # Single test or test pattern

# === HELPER FUNCTIONS ===
run_tests() {
    local commit=$1
    cd "$REPO_PATH"
    git checkout -q "$commit"

    # Run tests and capture results
    # Modify this section based on your test framework
    local output
    local exit_code=0
    output=$($TEST_CMD 2>&1) || exit_code=$?

    # Parse test results (adjust for your framework)
    local total=$(echo "$output" | grep -c "^--- " || echo "0")
    local failed=$(echo "$output" | grep -c "^--- FAIL" || echo "0")
    local passed=$((total - failed))

    echo "{\\"total\\": $total, \\"passed\\": $passed, \\"failed\\": $failed}"
    cd - > /dev/null
    return $exit_code
}

