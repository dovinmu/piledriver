def find_tla2tools() -> Optional[Path]:
    """Find tla2tools.jar from various locations."""
    candidates = [
        Path.cwd() / "tools" / "tla2tools.jar",
        Path(__file__).resolve().parent / "tools" / "tla2tools.jar",
        Path(os.environ.get("PILEDRIVER_HOME", "")) / "tools" / "tla2tools.jar" if os.environ.get("PILEDRIVER_HOME") else None,
        Path(os.environ.get("TLA2TOOLS", "")) if os.environ.get("TLA2TOOLS") else None,
    ]

    for path in candidates:
        if path and path.exists():
            return path
    return None


def find_community_modules() -> Optional[Path]:
    """Find CommunityModules-deps.jar from various locations.

    The CommunityModules jar provides modules like IOUtils, CSV, etc. that
    aren't bundled in tla2tools.jar but are commonly used by real-world specs.
    """
    candidates = [
        Path.cwd() / "tools" / "CommunityModules-deps.jar",
        Path(__file__).resolve().parent / "tools" / "CommunityModules-deps.jar",
        Path(os.environ.get("PILEDRIVER_HOME", "")) / "tools" / "CommunityModules-deps.jar" if os.environ.get("PILEDRIVER_HOME") else None,
        Path(os.environ.get("COMMUNITY_MODULES", "")) if os.environ.get("COMMUNITY_MODULES") else None,
    ]

    for path in candidates:
        if path and path.exists():
            return path
    return None


def build_tlc_command(tla2tools: Path, tla_path: Path, metadir: str,
                      cfg_path: Optional[Path], sany_only: bool) -> list:
    """Build the java command for invoking TLC or SANY.

    Adds CommunityModules-deps.jar to the classpath when present so that specs
    using IOUtils, CSV, etc. can be parsed.
    """
    classpath = [str(tla2tools)]
    community = find_community_modules()
    if community:
        classpath.append(str(community))
    cp = os.pathsep.join(classpath)

    if sany_only:
        return ["java", "-cp", cp, "tla2sany.SANY", str(tla_path)]

    cmd = ["java", "-cp", cp, "tlc2.TLC", str(tla_path), "-metadir", metadir]
    if cfg_path:
        cmd.extend(["-config", str(cfg_path)])
    return cmd


def parse_tlc_output(output: str) -> dict:
    """Parse TLC output for key information."""
    import re

    result = {
        "success": True,
        "states_generated": 0,
        "distinct_states": 0,
        "violations": [],
        "errors": [],
    }

    for line in output.split("\n"):
        # Parse state counts
        if "states generated" in line.lower():
            match = re.search(r"(\d+)\s+states generated.*?(\d+)\s+distinct", line, re.IGNORECASE)
            if match:
                result["states_generated"] = int(match.group(1))
                result["distinct_states"] = int(match.group(2))

        # Detect errors
        if line.strip().startswith("Error:") or "Semantic error" in line:
            result["errors"].append(line.strip())
            result["success"] = False

        # Detect invariant violations
        if "Invariant" in line and "violated" in line.lower():
            result["violations"].append(line.strip())
            result["success"] = False

        # Other violation indicators
        if "Error: Invariant" in line or "is violated" in line:
            if line.strip() not in result["violations"]:
                result["violations"].append(line.strip())
            result["success"] = False

    return result


def cmd_check(args):
    """Run TLC model checker on session spec."""
    session_name = resolve_session(getattr(args, 'session_name', None), "check")
    if not session_name:
        return 1
    sany_only = getattr(args, 'sany', False)

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    # Find model files
    model_tla = session_dir / "model.tla"
    model_cfg = session_dir / "model.cfg"

    if not model_tla.exists():
        print(f"Error: No model.tla found in {session_dir}")
        return 1

    # Find tla2tools.jar
    tla2tools = find_tla2tools()
    if not tla2tools:
        print("Error: Cannot find tla2tools.jar")
        print("Set PILEDRIVER_HOME or TLA2TOOLS environment variable,")
        print("or place tla2tools.jar in ./tools/")
        return 1

    # Create output directory
    tlc_out = session_dir / "_tlc_out"
    tlc_out.mkdir(exist_ok=True)

    # Check for java (macOS has a stub that prompts to install, so verify it works)
    try:
        result = subprocess.run(["java", "-version"], capture_output=True, text=True, timeout=5)
        if "version" not in result.stderr.lower() and "version" not in result.stdout.lower():
            raise FileNotFoundError("java stub")
    except (FileNotFoundError, subprocess.TimeoutExpired):
