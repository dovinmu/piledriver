def parse_scenario_yaml(path: Path) -> dict:
    """Parse a simple scenario.yaml file. Returns dict with config values."""
    config = {
        "base_commit": "",
        "fix_commit": "",
        "repo_path": "",
        "setup_commands": [],
    }

    if not path.exists():
        return config

    content = path.read_text()
    current_list_key = None

    for line in content.splitlines():
        # Skip comments and empty lines
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            current_list_key = None
            continue

        # Handle list items (for setup_commands)
        if stripped.startswith("- ") and current_list_key:
            value = stripped[2:].strip().strip('"').strip("'")
            config[current_list_key].append(value)
            continue

        # Handle key: value pairs
        if ":" in stripped:
            key, _, value = stripped.partition(":")
            key = key.strip()
            value = value.strip().strip('"').strip("'")

            if key in config:
                if key == "setup_commands":
                    current_list_key = key
                else:
                    config[key] = value
                    current_list_key = None

    return config


def git_get_state(repo_path: Path) -> dict:
    """Get current git state (branch/commit, dirty status)."""
    try:
        # Get current commit
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=repo_path, capture_output=True, text=True, check=True
        )
        commit = result.stdout.strip()

        # Get current branch (if any)
        result = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=repo_path, capture_output=True, text=True, check=True
        )
        branch = result.stdout.strip()
        if branch == "HEAD":
            branch = None  # Detached HEAD

        # Check for uncommitted changes
        result = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=repo_path, capture_output=True, text=True, check=True
        )
        dirty = bool(result.stdout.strip())

        return {"commit": commit, "branch": branch, "dirty": dirty}
    except subprocess.CalledProcessError:
        return None


def git_stash_if_dirty(repo_path: Path, state: dict) -> bool:
    """Stash changes if working directory is dirty. Returns True if stashed."""
    if not state or not state.get("dirty"):
        return False

    try:
        subprocess.run(
            ["git", "stash", "push", "-m", "piledriver-test-stash"],
            cwd=repo_path, capture_output=True, text=True, check=True
        )
        return True
    except subprocess.CalledProcessError:
        return False


def git_checkout(repo_path: Path, commit: str) -> bool:
    """Checkout a specific commit. Returns True on success."""
    try:
        subprocess.run(
            ["git", "checkout", "-q", commit],
            cwd=repo_path, capture_output=True, text=True, check=True
        )
        return True
    except subprocess.CalledProcessError as e:
        print(f"    git checkout failed: {e.stderr.strip()}")
        return False


def git_restore_state(repo_path: Path, state: dict, stashed: bool):
    """Restore git to original state."""
    if not state:
        return

    try:
        # Checkout original branch or commit
        target = state.get("branch") or state.get("commit")
        if target:
            subprocess.run(
                ["git", "checkout", "-q", target],
                cwd=repo_path, capture_output=True, text=True, check=True
            )

        # Pop stash if we stashed
        if stashed:
            subprocess.run(
                ["git", "stash", "pop"],
                cwd=repo_path, capture_output=True, text=True, check=True
            )
    except subprocess.CalledProcessError:
        pass  # Best effort restore


def run_reproduce_script(bug_dir: Path, repo_path: Path, setup_commands: list) -> tuple:
    """Run reproduce.sh and return (exit_code, output)."""
    # Run setup commands first
    for cmd in setup_commands:
        try:
            subprocess.run(
                cmd, shell=True, cwd=repo_path,
                capture_output=True, text=True, check=True
            )
        except subprocess.CalledProcessError as e:
            return (-1, f"Setup command failed: {cmd}\n{e.stderr}")

    # Run reproduce.sh
    reproduce_sh = bug_dir / "reproduce.sh"
    try:
        result = subprocess.run(
            ["bash", str(reproduce_sh)],
            cwd=repo_path,
            capture_output=True,
            text=True,
            timeout=300  # 5 minute timeout per run
        )
        return (result.returncode, result.stdout + result.stderr)
    except subprocess.TimeoutExpired:
        return (-1, "TIMEOUT: exceeded 5 minutes")
    except Exception as e:
        return (-1, str(e))


def cmd_test(args):
    """Run before/after test validation for reproducers."""
    session_name = args.session_name
    bug_name = args.bug_name

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    reproducers_dir = session_dir / "reproducers"
    if not reproducers_dir.exists():
        print(f"No reproducers found for session '{session_name}'.")
        return 1

    # Determine which bugs to test
    if bug_name:
        bug_dirs = [reproducers_dir / bug_name]
        if not bug_dirs[0].exists():
            print(f"Error: Bug reproducer '{bug_name}' not found.")
            return 1
    else:
        bug_dirs = [d for d in reproducers_dir.iterdir() if d.is_dir()]
        if not bug_dirs:
            print(f"No bug reproducers found in {reproducers_dir}")
            return 1

    results = []
    for bug_dir in sorted(bug_dirs):
        bug = bug_dir.name
        scenario_file = bug_dir / "scenario.yaml"
        reproduce_sh = bug_dir / "reproduce.sh"
        results_file = bug_dir / "results.json"

        # Check for required files
        if not reproduce_sh.exists():
            print(f"[{bug}] SKIP - no reproduce.sh")
            results.append((bug, "SKIP", "no reproduce.sh"))
            continue

        config = parse_scenario_yaml(scenario_file)
        base_commit = config.get("base_commit", "").strip()
        fix_commit = config.get("fix_commit", "").strip()
        repo_path_str = config.get("repo_path", "").strip()
        setup_commands = config.get("setup_commands", [])

        if not base_commit:
            print(f"[{bug}] SKIP - base_commit not set in scenario.yaml")
            results.append((bug, "SKIP", "base_commit not set"))
            continue

        # Determine repo path
        if repo_path_str:
            repo_path = Path(repo_path_str)
            if not repo_path.is_absolute():
                repo_path = bug_dir / repo_path_str
        else:
            # Default: search upward from piledriver dir for .git
            repo_path = piledriver_dir.parent
            while repo_path != repo_path.parent:
                if (repo_path / ".git").exists():
                    break
                repo_path = repo_path.parent

        if not (repo_path / ".git").exists():
            print(f"[{bug}] ERROR - no git repo found at {repo_path}")
            results.append((bug, "ERROR", "no git repo found"))
            continue

        print(f"[{bug}] Testing in {repo_path}...")

        # Save git state
        original_state = git_get_state(repo_path)
        if not original_state:
            print(f"[{bug}] ERROR - could not get git state")
            results.append((bug, "ERROR", "git state error"))
            continue

        stashed = git_stash_if_dirty(repo_path, original_state)
        if stashed:
            print(f"    Stashed uncommitted changes")

        try:
            # Test on base commit (should FAIL - bug present)
            print(f"    Checking out base: {base_commit[:8]}...")
            if not git_checkout(repo_path, base_commit):
                results.append((bug, "ERROR", "git checkout base failed"))
                continue

            base_exit, base_output = run_reproduce_script(bug_dir, repo_path, setup_commands)
            base_failed = base_exit != 0
            print(f"    Base result: {'FAIL' if base_failed else 'PASS'} (exit {base_exit})")

            # Test on fix commit if specified
            if fix_commit:
                print(f"    Checking out fix: {fix_commit[:8]}...")
                if not git_checkout(repo_path, fix_commit):
                    results.append((bug, "ERROR", "git checkout fix failed"))
                    continue

                fix_exit, fix_output = run_reproduce_script(bug_dir, repo_path, setup_commands)
                fix_passed = fix_exit == 0
                print(f"    Fix result: {'PASS' if fix_passed else 'FAIL'} (exit {fix_exit})")

                # Evaluate: base should fail, fix should pass
                if base_failed and fix_passed:
                    status = "PASS"
                    detail = f"base fails (exit {base_exit}), fix passes"
                elif not base_failed:
                    status = "FAIL"
                    detail = f"base should fail but passed (exit {base_exit})"
                else:
                    status = "FAIL"
                    detail = f"fix should pass but failed (exit {fix_exit})"

                # Write results.json
                result_data = {
                    "base_commit": base_commit,
                    "fix_commit": fix_commit,
                    "base_exit": base_exit,
                    "fix_exit": fix_exit,
                    "success": base_failed and fix_passed,
                }
            else:
                # No fix commit - just confirm bug exists
                if base_failed:
                    status = "CONFIRMED"
                    detail = f"bug confirmed (exit {base_exit})"
                else:
                    status = "FAIL"
                    detail = f"test passed on base - bug not reproduced (exit {base_exit})"

                result_data = {
                    "base_commit": base_commit,
                    "fix_commit": None,
                    "base_exit": base_exit,
                    "fix_exit": None,
                    "success": "bug_confirmed" if base_failed else False,
                }

            # Write results.json
            with open(results_file, "w") as f:
                json.dump(result_data, f, indent=2)

            print(f"[{bug}] {status} ({detail})")
            results.append((bug, status, detail))

        finally:
            # Always restore git state
            print(f"    Restoring git state...")
            git_restore_state(repo_path, original_state, stashed)

    # Print summary
    print()
    print("=" * 60)
    print("Summary:")
    passed = sum(1 for _, status, _ in results if status == "PASS")
    failed = sum(1 for _, status, _ in results if status == "FAIL")
    total = len(results)
    print(f"  {passed}/{total} reproducers passing")

    for bug, status, detail in results:
        icon = "+" if status == "PASS" else "-" if status == "FAIL" else "?"
        print(f"  [{icon}] {bug}: {status}")

    # Print guidance
    if passed == total and total > 0:
        print(format_guidance("test:success", session=session_name))
    elif failed > 0:
        # Get first failed bug for guidance
        first_failed = next((b for b, s, _ in results if s == "FAIL"), bug_name or "bug")
        print(format_guidance("test:failure", session=session_name, bug=first_failed))

    return 0 if passed == total else 1


def cmd_status(args):
    """Show current state of piledriver."""
    session_name = args.session_name

    piledriver_dir = get_piledriver_root()

    if not piledriver_dir.exists():
        print("No piledriver directory found.")
        print("Run 'piledriver init <session_name>' to start.")
        return 1

    if session_name:
        # Show specific session details
        session_dir = piledriver_dir / session_name
        if not session_dir.exists():
            print(f"Error: Session '{session_name}' not found.")
            return 1

        # Read state
        state = read_state(session_dir)
        phase = state.get("current_phase", "UNKNOWN") if state else "NO STATE"

        print(f"Session: {session_name}")
        print(f"Phase: {phase}")

        # List files
        files = []
        for f in ["reconnaissance.md", "boundary.md", "assumptions.md", "model.tla", "model.cfg", "probe.md"]:
            if (session_dir / f).exists():
                files.append(f)
        print(f"Files: {', '.join(files)}")

        # List reproducers
        reproducers_dir = session_dir / "reproducers"
        if reproducers_dir.exists():
            bug_dirs = sorted([d for d in reproducers_dir.iterdir() if d.is_dir()])
            if bug_dirs:
                print()
                print("Reproducers:")
                for bug_dir in bug_dirs:
                    bug = bug_dir.name
                    results_file = bug_dir / "results.json"

                    if results_file.exists():
                        try:
                            with open(results_file) as f:
                                data = json.load(f)
                            success = data.get("success", False)
                            base_result = data.get("base_result") or {}
                            fix_result = data.get("fix_result")
                            fix_commit = data.get("fix_commit")

                            if fix_result is None or fix_commit is None:
                                if success == "bug_confirmed":
                                    status = "PENDING (bug confirmed - set FIX_COMMIT)"
                                elif success == "inconclusive":
                                    status = "PENDING (inconclusive - retry)"
                                else:
                                    status = "ERROR (fix_result is null)"
                            elif success is True:
                                base_failed = base_result.get("failed", 0)
                                fix_failed = fix_result.get("failed", 0)
                                status = f"PASS (base: {base_failed} fail, fix: {fix_failed} fail)"
                            else:
                                base_failed = base_result.get("failed", 0)
                                fix_failed = fix_result.get("failed", 0)
                                status = f"FAIL (base: {base_failed} fail, fix: {fix_failed} fail)"
                        except (json.JSONDecodeError, KeyError):
                            status = "ERROR (invalid results.json)"
                    else:
                        status = "NOT RUN"

                    print(f"  {bug:<30} {status}")
            else:
                print()
                print("Reproducers: none")
        else:
            print()
            print("Reproducers: none")

        # Print guidance for current phase
        if phase and phase != "UNKNOWN" and phase != "NO STATE":
            guidance_key = f"set-phase:{phase}"
            if guidance_key in GUIDANCE:
                print(format_guidance(guidance_key, session=session_name))

    else:
        # List all sessions
        sessions = sorted([
            d for d in piledriver_dir.iterdir()
            if d.is_dir() and not d.name.startswith(".")
        ])

        if not sessions:
            print("No sessions found.")
            print("Run 'piledriver init <session_name>' to start.")
            return 0

        print("Piledriver Sessions:")
        for session_dir in sessions:
            session = session_dir.name
            reproducers_dir = session_dir / "reproducers"

            # Get phase
            state = read_state(session_dir)
            phase = state.get("current_phase", "?") if state else "?"

            if reproducers_dir.exists():
                bug_dirs = [d for d in reproducers_dir.iterdir() if d.is_dir()]
                num_bugs = len(bug_dirs)

                # Count passing reproducers
                passing = 0
                for bug_dir in bug_dirs:
                    results_file = bug_dir / "results.json"
                    if results_file.exists():
                        try:
                            with open(results_file) as f:
                                data = json.load(f)
                            if data.get("success", False):
                                passing += 1
                        except (json.JSONDecodeError, KeyError):
                            pass

                if num_bugs > 0:
                    detail = f"[{phase}] ({num_bugs} reproducers, {passing} passing)"
                else:
                    detail = f"[{phase}] (0 reproducers)"
            else:
                detail = f"[{phase}] (0 reproducers)"

            print(f"  {session:<20} {detail}")

    return 0


