    set_phase_parser.add_argument("session_name", help="Session to transition")
    set_phase_parser.add_argument("phase", help="Target phase (RECONNAISSANCE, SCOPING, ASSUMPTIONS, VERIFICATION, REPORT)")
    set_phase_parser.add_argument("--force", action="store_true", help="Force transition even if validation fails")

    # check command
    check_parser = subparsers.add_parser("check", help="Run TLC model checker")
    check_parser.add_argument("session_name", nargs="?", help="Session to check (auto-detected if only one)")
    check_parser.add_argument("--sany", action="store_true", help="Syntax check only (no model checking)")

    # tlc command (session-independent)
    tlc_parser = subparsers.add_parser("tlc", help="Run TLC/SANY on an arbitrary .tla file (no session required)")
    tlc_parser.add_argument("tla_file", help="Path to the .tla file")
    tlc_parser.add_argument("cfg_file", nargs="?",
                            help="Path to the .cfg file (defaults to required <tla_file>.cfg sibling for TLC; optional with --sany)")
    tlc_parser.add_argument("--sany", action="store_true", help="Syntax check only (no model checking)")

    # pr command
    pr_parser = subparsers.add_parser("pr", help="Generate PR draft from report")
    pr_parser.add_argument("session_name", help="Session to generate PR for")

    # technique command
    technique_parser = subparsers.add_parser("technique", help="View or set verification technique")
    technique_parser.add_argument("session_name", help="Session to configure")
    technique_parser.add_argument("technique", nargs="?",
                                  help="Technique to set (tla+, property-test, fuzz, diff-test, manual)")

    # summary command
    summary_parser = subparsers.add_parser("summary", help="View or set task summary")
    summary_parser.add_argument("session_name", help="Session to configure")
    summary_parser.add_argument("summary", nargs="?", help="Summary text (view if not provided)")

    # critique command
    critique_parser = subparsers.add_parser("critique", help="Send context to critic agent for feedback")
    critique_parser.add_argument("session_name", help="Session to critique")
    critique_parser.add_argument("context", help="Context/state to send to the critic")

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return 1

    if args.command == "init":
        return cmd_init(args)
    elif args.command == "bug":
        return cmd_bug(args)
    elif args.command == "test":
        return cmd_test(args)
    elif args.command == "status":
        return cmd_status(args)
    elif args.command == "set-phase":
        return cmd_set_phase(args)
    elif args.command == "check":
        return cmd_check(args)
    elif args.command == "tlc":
        return cmd_tlc(args)
    elif args.command == "pr":
        return cmd_pr(args)
    elif args.command == "technique":
        return cmd_technique(args)
    elif args.command == "summary":
        return cmd_summary(args)
    elif args.command == "critique":
        return cmd_critique(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
