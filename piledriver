def format_guidance(template_key: str, **kwargs) -> str:
    """Format guidance output for a command."""
    template = GUIDANCE.get(template_key, {})
    if not template:
        return ""

    lines = []

    # Summary
    summary = template.get("summary", "").format(**kwargs)
    if summary:
        lines.append(f"\n{summary}")
        lines.append("")

    # Next steps
    steps = template.get("next_steps", [])
    if steps:
        lines.append("Next steps:")
        for step in steps:
            formatted = step.format(**kwargs)
            lines.append(f"  {formatted}")
        lines.append("")

    # Reminder
    reminder = template.get("reminder", "").format(**kwargs)
    if reminder:
        lines.append(f"Note: {reminder}")

    return "\n".join(lines)


def get_piledriver_root() -> Path:
    """Find the .piledriver directory, searching upward from cwd."""
    cwd = Path.cwd()
    for parent in [cwd] + list(cwd.parents):
        if (parent / PILEDRIVER_DIR).exists():
            return parent / PILEDRIVER_DIR
    return cwd / PILEDRIVER_DIR


def validate_session_name(name: str) -> tuple:
    """Validate session name. Returns (valid: bool, error: str)."""
    if not name:
        return False, "Session name cannot be empty"
    if name != name.lower():
        return False, f"Session name must be lowercase (got '{name}', try '{name.lower()}')"
    if not name[0].isalpha():
        return False, "Session name must start with a letter"
    if not all(c.isalnum() or c in '-_' for c in name):
        return False, "Session name can only contain letters, numbers, hyphens, and underscores"
    return True, ""


def cmd_init(args):
    """Initialize a new analysis session."""
    session_name = args.session_name
    skip_recon = getattr(args, 'skip_recon', False)

    # Validate session name
    valid, error = validate_session_name(session_name)
    if not valid:
        print(f"Error: {error}")
        return 1

    piledriver_dir = Path.cwd() / PILEDRIVER_DIR
    session_dir = piledriver_dir / session_name

    if session_dir.exists():
        print(f"Error: Session '{session_name}' already exists at {session_dir}")
        return 1

    # Determine initial phase
    initial_phase = "SCOPING" if skip_recon else "RECONNAISSANCE"

    # Create directories
    session_dir.mkdir(parents=True)

    # Create state.json
    state = create_initial_state(session_name, initial_phase)
    write_state(session_dir, state)

    # Create placeholder files
    (session_dir / "reconnaissance.md").write_text(
        RECONNAISSANCE_TEMPLATE.format(session_name=session_name)
    )
    (session_dir / "boundary.md").write_text(
        BOUNDARY_TEMPLATE.format(session_name=session_name)
    )
