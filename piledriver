PILEDRIVER_DIR = ".piledriver"

# Phase constants
PHASES = ["IDLE", "SCOPING", "ASSUMPTIONS", "VERIFICATION", "REPORT"]


# === State file management ===

def read_state(session_dir: Path) -> dict | None:
    """Read state.json from a session directory, with file locking."""
    state_file = session_dir / "state.json"
    if not state_file.exists():
        return None

    lock_file = session_dir / "state.json.lock"
    with open(lock_file, "w") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_SH)  # Shared lock for reading
        try:
            with open(state_file) as f:
                return json.load(f)
        except json.JSONDecodeError:
            return None
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def write_state(session_dir: Path, state: dict) -> None:
    """Write state.json to a session directory, with file locking."""
    state_file = session_dir / "state.json"
    lock_file = session_dir / "state.json.lock"

    state["last_modified"] = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')

    with open(lock_file, "w") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)  # Exclusive lock for writing
        try:
            with open(state_file, "w") as f:
                json.dump(state, f, indent=2)
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def create_initial_state(session_name: str) -> dict:
    """Create a new state dictionary for a session."""
    now = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
    return {
        "session": session_name,
        "current_phase": "IDLE",
        "phase_history": [
            {"phase": "IDLE", "entered": now}
        ],
        "phase_notes": {},
        "created": now,
        "last_modified": now
    }


def transition_phase(session_dir: Path, new_phase: str) -> bool:
    """Transition to a new phase. Returns True on success."""
    if new_phase not in PHASES:
        return False

    state = read_state(session_dir)
    if state is None:
        return False

    state["current_phase"] = new_phase
    state["phase_history"].append({
        "phase": new_phase,
        "entered": datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
    })

    write_state(session_dir, state)
    return True

# === Phase validation ===

def is_file_filled(path: Path, template_marker: str = "<!--") -> bool:
    """Check if a file has been filled beyond the template."""
    if not path.exists():
        return False
    content = path.read_text()
    # Remove HTML comments (template instructions)
    lines = content.split("\n")
    content_lines = []
    in_comment = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("<!--"):
            in_comment = True
        if not in_comment and stripped and not stripped.startswith("#") and not stripped.startswith("|"):
            # Skip table separators too
            if not stripped.startswith("-"):
                content_lines.append(line)
        if "-->" in stripped:
            in_comment = False
    # Check for meaningful content beyond headers and empty bullets
    meaningful = [l for l in content_lines if l.strip() and l.strip() != "-"]
    return len(meaningful) > 0


def validate_phase_transition(session_dir: Path, current_phase: str, new_phase: str) -> tuple:
    """
    Validate a phase transition.
    Returns (allowed: bool, reason: str).
    """
    # Rescope to SCOPING is always allowed
    if new_phase == "SCOPING":
        return True, "Rescoping is always allowed"

    # Closing from REPORT is always allowed
    if new_phase == "IDLE" and current_phase == "REPORT":
        return True, "Closing hunt from REPORT"

    # Starting a hunt from IDLE
    if current_phase == "IDLE" and new_phase == "SCOPING":
        return True, "Starting hunt"

    # Forward transitions with requirements
    if current_phase == "SCOPING" and new_phase == "ASSUMPTIONS":
        if is_file_filled(session_dir / "boundary.md"):
            return True, "boundary.md has content"
        return False, "boundary.md must be filled before advancing"

    if current_phase == "ASSUMPTIONS" and new_phase == "VERIFICATION":
        if is_file_filled(session_dir / "assumptions.md"):
            return True, "assumptions.md has content"
        return False, "assumptions.md must be filled before advancing"

    if current_phase == "VERIFICATION" and new_phase == "REPORT":
        if is_file_filled(session_dir / "model.tla", "\\*"):
            return True, "model.tla has content"
        return False, "model.tla must be filled before advancing"

    # Check phase order
    if new_phase not in PHASES:
        return False, f"Invalid phase: {new_phase}"

    try:
        current_idx = PHASES.index(current_phase)
        new_idx = PHASES.index(new_phase)
    except ValueError:
        return False, f"Invalid phase: {current_phase} or {new_phase}"

    if new_idx > current_idx + 1:
        return False, f"Cannot skip phases. Current: {current_phase}, requested: {new_phase}"

    if new_idx < current_idx and new_phase != "SCOPING":
        return False, f"Can only go back to SCOPING (rescope), not {new_phase}"

    return False, f"Invalid transition from {current_phase} to {new_phase}"


