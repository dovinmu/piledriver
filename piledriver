BASE_RESULT=$(run_tests "$BASE_COMMIT") || true

echo "Testing fix commit: $FIX_COMMIT"
FIX_RESULT=$(run_tests "$FIX_COMMIT")

# Compute success
BASE_FAILED=$(echo "$BASE_RESULT" | jq -r '.failed')
FIX_FAILED=$(echo "$FIX_RESULT" | jq -r '.failed')

