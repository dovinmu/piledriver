  "base_commit": "$BASE_COMMIT",
  "fix_commit": "$FIX_COMMIT",
  "base_result": $BASE_RESULT,
  "fix_result": $FIX_RESULT,
  "success": $SUCCESS
}
EOF

echo "Results written to results.json"
echo "Success: $SUCCESS"
"""


