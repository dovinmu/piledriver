def format_guidance(template_key: str, **kwargs) -> str:
    """Format guidance output for a command."""
    template = GUIDANCE.get(template_key, {})
    if not template:
        return ""

    lines = []

    # Summary
    summary = template.get("summary", "").format(**kwargs)
    if summary:
        lines.append(f"\n{summary}")
        lines.append("")

    # Next steps
    steps = template.get("next_steps", [])
    if steps:
        lines.append("Next steps:")
        for step in steps:
            formatted = step.format(**kwargs)
            lines.append(f"  {formatted}")
        lines.append("")

    # Reminder
    reminder = template.get("reminder", "").format(**kwargs)
    if reminder:
        lines.append(f"Note: {reminder}")

    return "\n".join(lines)


def get_piledriver_root() -> Path:
    """Find the .piledriver directory, searching upward from cwd."""
    cwd = Path.cwd()
    for parent in [cwd] + list(cwd.parents):
        if (parent / PILEDRIVER_DIR).exists():
            return parent / PILEDRIVER_DIR
    return cwd / PILEDRIVER_DIR


def cmd_init(args):
    """Initialize a new analysis session."""
    session_name = args.session_name
    piledriver_dir = Path.cwd() / PILEDRIVER_DIR
    session_dir = piledriver_dir / session_name

    if session_dir.exists():
        print(f"Error: Session '{session_name}' already exists at {session_dir}")
        return 1

    # Create directories
    session_dir.mkdir(parents=True)

    # Create state.json
    state = create_initial_state(session_name)
    write_state(session_dir, state)

    # Create placeholder files
    (session_dir / "boundary.md").write_text(
        BOUNDARY_TEMPLATE.format(session_name=session_name)
    )
    (session_dir / "assumptions.md").write_text(ASSUMPTIONS_TEMPLATE)

    # Convert session name to valid TLA+ module name (PascalCase, no hyphens)
    module_name = "".join(word.capitalize() for word in session_name.replace("-", "_").split("_"))
    (session_dir / "model.tla").write_text(
        MODEL_TLA_TEMPLATE.format(module_name=module_name)
    )
    (session_dir / "probe.md").write_text(PROBE_TEMPLATE)

    print(f"Created session '{session_name}' at {session_dir}")
    print(f"  - state.json (phase: IDLE)")
    print(f"  - boundary.md")
    print(f"  - assumptions.md")
    print(f"  - model.tla")
    print(f"  - probe.md")

    # Print guidance
    print(format_guidance("init", session=session_name))

    return 0


def cmd_bug(args):
    """Create a bug reproducer scaffold."""
    session_name = args.session_name
    bug_name = args.bug_name

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        print(f"Run 'piledriver init {session_name}' first.")
        return 1

    reproducers_dir = session_dir / "reproducers"
    bug_dir = reproducers_dir / bug_name

    if bug_dir.exists():
        print(f"Error: Bug reproducer '{bug_name}' already exists at {bug_dir}")
        return 1

    # Create directories
    bug_dir.mkdir(parents=True)

    # Create stub files
    (bug_dir / "README.md").write_text(
        BUG_README_TEMPLATE.format(bug_name=bug_name)
    )
    runsh_path = bug_dir / "run.sh"
    runsh_path.write_text(BUG_RUNSH_TEMPLATE)
    runsh_path.chmod(0o755)

    print(f"Created bug reproducer '{bug_name}' at {bug_dir}")
    print(f"  - README.md")
    print(f"  - run.sh (executable)")

    # Print guidance
    print(format_guidance("bug", session=session_name, bug=bug_name))

    return 0


def cmd_test(args):
    """Run before/after test validation for reproducers."""
    session_name = args.session_name
    bug_name = args.bug_name

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    reproducers_dir = session_dir / "reproducers"
    if not reproducers_dir.exists():
        print(f"No reproducers found for session '{session_name}'.")
        return 1

    # Determine which bugs to test
    if bug_name:
        bug_dirs = [reproducers_dir / bug_name]
        if not bug_dirs[0].exists():
            print(f"Error: Bug reproducer '{bug_name}' not found.")
            return 1
    else:
        bug_dirs = [d for d in reproducers_dir.iterdir() if d.is_dir()]
        if not bug_dirs:
            print(f"No bug reproducers found in {reproducers_dir}")
            return 1

    results = []
    for bug_dir in sorted(bug_dirs):
        bug = bug_dir.name
        runsh = bug_dir / "run.sh"
        results_file = bug_dir / "results.json"

        if not runsh.exists():
            print(f"[{bug}] SKIP - no run.sh")
            results.append((bug, "SKIP", "no run.sh"))
            continue

        print(f"[{bug}] Running...")

        # Execute run.sh
        try:
            result = subprocess.run(
                ["bash", str(runsh)],
                cwd=str(bug_dir),
                capture_output=True,
                text=True,
                timeout=600  # 10 minute timeout
            )
        except subprocess.TimeoutExpired:
            print(f"[{bug}] TIMEOUT")
            results.append((bug, "TIMEOUT", "exceeded 10 minutes"))
            continue
        except Exception as e:
            print(f"[{bug}] ERROR - {e}")
            results.append((bug, "ERROR", str(e)))
            continue

        # Read results.json
        if not results_file.exists():
            print(f"[{bug}] ERROR - no results.json generated")
            results.append((bug, "ERROR", "no results.json"))
            continue

        try:
            with open(results_file) as f:
                data = json.load(f)
        except json.JSONDecodeError as e:
            print(f"[{bug}] ERROR - invalid results.json: {e}")
            results.append((bug, "ERROR", f"invalid JSON: {e}"))
            continue

        # Evaluate results
        success = data.get("success", False)
        base_result = data.get("base_result") or {}
        fix_result = data.get("fix_result")
        fix_commit = data.get("fix_commit")

        # Handle intermediate state: bug confirmed but no fix commit set
        if fix_result is None or fix_commit is None:
            if success == "bug_confirmed":
                status = "PENDING"
                detail = "bug confirmed - set FIX_COMMIT in run.sh to validate fix"
            elif success == "inconclusive":
                status = "PENDING"
                detail = "bug not reliably reproduced - adjust test or retry"
            else:
                status = "ERROR"
                detail = f"fix_result is null but success={success!r} (expected 'bug_confirmed')"
            print(f"[{bug}] {status} ({detail})")
            results.append((bug, status, detail))
            continue

        base_failed = base_result.get("failed", 0)
        fix_failed = fix_result.get("failed", 0)

        if success is True:
            status = "PASS"
            detail = f"base: {base_failed} fail, fix: {fix_failed} fail"
        else:
            status = "FAIL"
            if base_failed == 0:
                detail = f"base had 0 failures (expected >0)"
            elif fix_failed > 0:
                detail = f"fix still has {fix_failed} failures"
            else:
                detail = f"base: {base_failed} fail, fix: {fix_failed} fail"

        print(f"[{bug}] {status} ({detail})")
        results.append((bug, status, detail))

    # Print summary
    print()
    print("=" * 60)
    print("Summary:")
    passed = sum(1 for _, status, _ in results if status == "PASS")
    total = len(results)
    print(f"  {passed}/{total} reproducers passing")

    for bug, status, detail in results:
        icon = "+" if status == "PASS" else "-" if status == "FAIL" else "?"
        print(f"  [{icon}] {bug}: {status}")

    return 0 if passed == total else 1


def cmd_status(args):
    """Show current state of piledriver."""
    session_name = args.session_name

    piledriver_dir = get_piledriver_root()

    if not piledriver_dir.exists():
        print("No .piledriver directory found.")
        print("Run 'piledriver init <session_name>' to start.")
        return 1

    if session_name:
        # Show specific session details
        session_dir = piledriver_dir / session_name
        if not session_dir.exists():
            print(f"Error: Session '{session_name}' not found.")
            return 1

        # Read state
        state = read_state(session_dir)
        phase = state.get("current_phase", "UNKNOWN") if state else "NO STATE"

        print(f"Session: {session_name}")
        print(f"Phase: {phase}")

        # List files
        files = []
        for f in ["boundary.md", "assumptions.md", "model.tla", "model.cfg", "probe.md"]:
            if (session_dir / f).exists():
                files.append(f)
        print(f"Files: {', '.join(files)}")

        # List reproducers
        reproducers_dir = session_dir / "reproducers"
        if reproducers_dir.exists():
            bug_dirs = sorted([d for d in reproducers_dir.iterdir() if d.is_dir()])
            if bug_dirs:
                print()
                print("Reproducers:")
                for bug_dir in bug_dirs:
                    bug = bug_dir.name
                    results_file = bug_dir / "results.json"

                    if results_file.exists():
                        try:
                            with open(results_file) as f:
                                data = json.load(f)
                            success = data.get("success", False)
                            base_result = data.get("base_result") or {}
                            fix_result = data.get("fix_result")
                            fix_commit = data.get("fix_commit")

                            if fix_result is None or fix_commit is None:
                                if success == "bug_confirmed":
                                    status = "PENDING (bug confirmed - set FIX_COMMIT)"
                                elif success == "inconclusive":
                                    status = "PENDING (inconclusive - retry)"
                                else:
                                    status = "ERROR (fix_result is null)"
                            elif success is True:
                                base_failed = base_result.get("failed", 0)
                                fix_failed = fix_result.get("failed", 0)
                                status = f"PASS (base: {base_failed} fail, fix: {fix_failed} fail)"
                            else:
                                base_failed = base_result.get("failed", 0)
                                fix_failed = fix_result.get("failed", 0)
                                status = f"FAIL (base: {base_failed} fail, fix: {fix_failed} fail)"
                        except (json.JSONDecodeError, KeyError):
                            status = "ERROR (invalid results.json)"
                    else:
                        status = "NOT RUN"

                    print(f"  {bug:<30} {status}")
            else:
                print()
                print("Reproducers: none")
        else:
            print()
            print("Reproducers: none")

    else:
        # List all sessions
        sessions = sorted([
            d for d in piledriver_dir.iterdir()
            if d.is_dir() and not d.name.startswith(".")
        ])

        if not sessions:
            print("No sessions found.")
            print("Run 'piledriver init <session_name>' to start.")
            return 0

        print("Piledriver Sessions:")
        for session_dir in sessions:
            session = session_dir.name
            reproducers_dir = session_dir / "reproducers"

            # Get phase
            state = read_state(session_dir)
            phase = state.get("current_phase", "?") if state else "?"

            if reproducers_dir.exists():
                bug_dirs = [d for d in reproducers_dir.iterdir() if d.is_dir()]
                num_bugs = len(bug_dirs)

                # Count passing reproducers
                passing = 0
                for bug_dir in bug_dirs:
                    results_file = bug_dir / "results.json"
                    if results_file.exists():
                        try:
                            with open(results_file) as f:
                                data = json.load(f)
                            if data.get("success", False):
                                passing += 1
                        except (json.JSONDecodeError, KeyError):
                            pass

                if num_bugs > 0:
                    detail = f"[{phase}] ({num_bugs} reproducers, {passing} passing)"
                else:
                    detail = f"[{phase}] (0 reproducers)"
            else:
                detail = f"[{phase}] (0 reproducers)"

            print(f"  {session:<20} {detail}")

    return 0


# === TLC helpers ===

def find_tla2tools() -> Path | None:
    """Find tla2tools.jar from various locations."""
    candidates = [
        Path.cwd() / "tools" / "tla2tools.jar",
        Path(__file__).resolve().parent / "tools" / "tla2tools.jar",
        Path(os.environ.get("PILEDRIVER_HOME", "")) / "tools" / "tla2tools.jar" if os.environ.get("PILEDRIVER_HOME") else None,
        Path(os.environ.get("TLA2TOOLS", "")) if os.environ.get("TLA2TOOLS") else None,
    ]

    for path in candidates:
        if path and path.exists():
            return path
    return None


def parse_tlc_output(output: str) -> dict:
    """Parse TLC output for key information."""
    import re

    result = {
        "success": True,
        "states_generated": 0,
        "distinct_states": 0,
        "violations": [],
        "errors": [],
    }

    for line in output.split("\n"):
        # Parse state counts
        if "states generated" in line.lower():
            match = re.search(r"(\d+)\s+states generated.*?(\d+)\s+distinct", line, re.IGNORECASE)
            if match:
                result["states_generated"] = int(match.group(1))
                result["distinct_states"] = int(match.group(2))

        # Detect errors
        if line.strip().startswith("Error:") or "Semantic error" in line:
            result["errors"].append(line.strip())
            result["success"] = False

        # Detect invariant violations
        if "Invariant" in line and "violated" in line.lower():
            result["violations"].append(line.strip())
            result["success"] = False

        # Other violation indicators
        if "Error: Invariant" in line or "is violated" in line:
            if line.strip() not in result["violations"]:
                result["violations"].append(line.strip())
            result["success"] = False

    return result


def cmd_check(args):
    """Run TLC model checker on session spec."""
    session_name = args.session_name
    sany_only = getattr(args, 'sany', False)

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    # Find model files
    model_tla = session_dir / "model.tla"
    model_cfg = session_dir / "model.cfg"

    if not model_tla.exists():
        print(f"Error: No model.tla found in {session_dir}")
        return 1

    # Find tla2tools.jar
    tla2tools = find_tla2tools()
    if not tla2tools:
        print("Error: Cannot find tla2tools.jar")
        print("Set PILEDRIVER_HOME or TLA2TOOLS environment variable,")
        print("or place tla2tools.jar in ./tools/")
        return 1

    # Create output directory
    tlc_out = session_dir / "_tlc_out"
    tlc_out.mkdir(exist_ok=True)

    # Build command
    if sany_only:
        cmd = ["java", "-cp", str(tla2tools), "tla2sany.SANY", str(model_tla)]
        print(f"Running syntax check on {model_tla.name}...")
    else:
        cmd = [
            "java", "-jar", str(tla2tools),
            str(model_tla),
            "-metadir", str(tlc_out),
        ]
        if model_cfg.exists():
            cmd.extend(["-config", str(model_cfg)])
        print(f"Running TLC on {model_tla.name}...")

    print(f"Command: {' '.join(cmd)}")
    print("-" * 60)

    # Run
    try:
        result = subprocess.run(
            cmd,
            cwd=str(session_dir),
            capture_output=True,
            text=True,
            timeout=600  # 10 minute timeout
        )
        output = result.stdout + result.stderr
        print(output)
    except subprocess.TimeoutExpired:
        print("Error: TLC timed out after 10 minutes")
        return 1
    except Exception as e:
        print(f"Error running TLC: {e}")
        return 1

    print("-" * 60)

    # Parse and summarize
    parsed = parse_tlc_output(output)

    # Update state.json with results
    state = read_state(session_dir)
    if state:
        if "tlc_results" not in state:
            state["tlc_results"] = []
        state["tlc_results"].append({
            "timestamp": datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z'),
            "sany_only": sany_only,
            "success": parsed["success"],
            "states_generated": parsed["states_generated"],
            "distinct_states": parsed["distinct_states"],
            "violations": parsed["violations"][:5],  # Limit stored violations
        })
        # Keep only last 10 results
        state["tlc_results"] = state["tlc_results"][-10:]
        write_state(session_dir, state)

    # Print summary
    print()
    print("Summary:")
    if sany_only:
        if parsed["errors"]:
            print("  Syntax errors found:")
            for err in parsed["errors"][:5]:
                print(f"    {err}")
            print(format_guidance("check:syntax_error", session=session_name))
        else:
            print("  Syntax OK")
    else:
        print(f"  States: {parsed['states_generated']} generated, {parsed['distinct_states']} distinct")
        if parsed["violations"]:
            print(f"  Violations: {len(parsed['violations'])}")
            for v in parsed["violations"][:3]:
                print(f"    {v}")
            print(format_guidance("check:violation", session=session_name))
        elif parsed["errors"]:
            print("  Errors found:")
            for err in parsed["errors"][:3]:
                print(f"    {err}")
        else:
            print("  No violations found")
            print(format_guidance("check:success", session=session_name))

    return 0 if parsed["success"] else 1


# === PR draft generation ===

PR_DRAFT_TEMPLATE = """# {title}

## Summary
{summary}

## Key Findings
{findings}

## Changes
{changes}

## Test Plan
{test_plan}

---
*Generated by piledriver from session `{session}`*
"""


def extract_section(content: str, header: str, default: str = "") -> str:
    """Extract a markdown section by header."""
    lines = content.split("\n")
    in_section = False
    section_lines = []

    for line in lines:
        if line.startswith(f"## {header}"):
            in_section = True
            continue
        elif line.startswith("## ") and in_section:
            break
        elif in_section:
            section_lines.append(line)

    return "\n".join(section_lines).strip() or default


def cmd_pr(args):
    """Generate a PR draft from a session."""
    session_name = args.session_name

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    # Read report.md if it exists
    report_path = session_dir / "report.md"
    report_content = ""
    if report_path.exists():
        report_content = report_path.read_text()
    else:
        print(f"Warning: No report.md found in {session_dir}")
        print("Creating basic PR draft from session info...")

    # Parse report for key sections
    summary = extract_section(report_content, "Summary", default="Investigation of suspected bug.")
    findings = extract_section(report_content, "Findings", default="- See report.md for details")
    recommendations = extract_section(report_content, "Recommendations", default="- Review changes")

    # Condense findings to first 5 bullet points
    findings_lines = [l for l in findings.split("\n") if l.strip().startswith("-") or l.strip().startswith("*")][:5]
    condensed_findings = "\n".join(findings_lines) if findings_lines else "- " + findings[:200]

    # Build test plan from reproducers
    reproducers_dir = session_dir / "reproducers"
    test_plan_items = []
    if reproducers_dir.exists():
        for bug_dir in sorted(reproducers_dir.iterdir()):
            if bug_dir.is_dir():
                results_file = bug_dir / "results.json"
                status = "not run"
                if results_file.exists():
                    try:
                        with open(results_file) as f:
                            data = json.load(f)
                        status = "PASS" if data.get("success") else "FAIL"
                    except (json.JSONDecodeError, KeyError):
                        status = "error"
                test_plan_items.append(f"- [ ] `{bug_dir.name}`: {status}")

    if not test_plan_items:
        test_plan_items = ["- [ ] Manual verification required"]

    # Generate title
    title_base = session_name.replace("-", " ").replace("_", " ").title()
    title = f"Fix: {title_base}"

    # Condense summary
    summary_condensed = summary.strip()[:500]
    if len(summary.strip()) > 500:
        summary_condensed += "..."

    # Write PR draft
    pr_draft = PR_DRAFT_TEMPLATE.format(
        title=title,
        summary=summary_condensed,
        findings=condensed_findings,
        changes=recommendations,
        test_plan="\n".join(test_plan_items),
        session=session_name
    )

    output_path = session_dir / "pr-draft.md"
    output_path.write_text(pr_draft)

    print(f"PR draft generated: {output_path}")
    print()
    print("Preview:")
    print("-" * 40)
    # Print first 25 lines
    for line in pr_draft.split("\n")[:25]:
        print(line)
    if len(pr_draft.split("\n")) > 25:
        print("...")
    print("-" * 40)

    # Print guidance
    print(format_guidance("pr", session=session_name))

    return 0


def cmd_set_phase(args):
    """Transition to a new phase with validation."""
    session_name = args.session_name
    new_phase = args.phase.upper()
    force = getattr(args, 'force', False)

    if new_phase not in PHASES:
        print(f"Error: Invalid phase '{new_phase}'")
        print(f"Valid phases: {', '.join(PHASES)}")
        return 1

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    state = read_state(session_dir)
    if state is None:
        print(f"Error: No state.json found for session '{session_name}'")
        return 1

    current_phase = state.get("current_phase", "IDLE")

    # Already in this phase?
    if current_phase == new_phase:
        print(f"Already in {new_phase} phase.")
        return 0

    # Validate transition
    allowed, reason = validate_phase_transition(session_dir, current_phase, new_phase)

    if not allowed and not force:
        print(f"Error: Cannot transition from {current_phase} to {new_phase}")
        print(f"Reason: {reason}")
        print()
        print("Use --force to override (not recommended)")
        return 1

    if not allowed and force:
        print(f"Warning: Forcing transition despite: {reason}")

    # Perform transition
    if not transition_phase(session_dir, new_phase):
        print(f"Error: Failed to transition to {new_phase}")
        return 1

    print(f"Phase: {current_phase} -> {new_phase}")

    # Print guidance
    guidance_key = f"set-phase:{new_phase}"
    print(format_guidance(guidance_key, session=session_name))

    return 0


def main():
    parser = argparse.ArgumentParser(
        description="Piledriver: TLA+ Bug Hunter CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Commands:
  init <session>              Start a new analysis session
  set-phase <session> <phase> Transition to a new phase
  bug <session> <bug>         Create a bug reproducer scaffold
  test <session> [bug]        Run before/after test validation
  status [session]            Show current state
  check <session>             Run TLC model checker
  pr <session>                Generate PR draft from report

Examples:
  piledriver init hugot-usage
  piledriver set-phase hugot-usage SCOPING
  piledriver bug hugot-usage bug1_close_race
  piledriver test hugot-usage
  piledriver check hugot-usage
  piledriver pr hugot-usage
  piledriver status
"""
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # init command
    init_parser = subparsers.add_parser("init", help="Start a new analysis session")
    init_parser.add_argument("session_name", help="Name for the session")

    # bug command
    bug_parser = subparsers.add_parser("bug", help="Create a bug reproducer scaffold")
    bug_parser.add_argument("session_name", help="Session to add the bug to")
    bug_parser.add_argument("bug_name", help="Name for the bug reproducer")

    # test command
    test_parser = subparsers.add_parser("test", help="Run before/after test validation")
    test_parser.add_argument("session_name", help="Session to test")
    test_parser.add_argument("bug_name", nargs="?", help="Specific bug to test (optional)")

    # status command
    status_parser = subparsers.add_parser("status", help="Show current state")
    status_parser.add_argument("session_name", nargs="?", help="Session to show details for")

    # set-phase command
    set_phase_parser = subparsers.add_parser("set-phase", help="Transition to a new phase")
    set_phase_parser.add_argument("session_name", help="Session to transition")
    set_phase_parser.add_argument("phase", help="Target phase (SCOPING, ASSUMPTIONS, VERIFICATION, REPORT, IDLE)")
    set_phase_parser.add_argument("--force", action="store_true", help="Force transition even if validation fails")

    # check command
    check_parser = subparsers.add_parser("check", help="Run TLC model checker")
    check_parser.add_argument("session_name", help="Session to check")
    check_parser.add_argument("--sany", action="store_true", help="Syntax check only (no model checking)")

    # pr command
    pr_parser = subparsers.add_parser("pr", help="Generate PR draft from report")
    pr_parser.add_argument("session_name", help="Session to generate PR for")

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return 1

    if args.command == "init":
        return cmd_init(args)
    elif args.command == "bug":
        return cmd_bug(args)
    elif args.command == "test":
        return cmd_test(args)
    elif args.command == "status":
        return cmd_status(args)
    elif args.command == "set-phase":
        return cmd_set_phase(args)
    elif args.command == "check":
        return cmd_check(args)
    elif args.command == "pr":
        return cmd_pr(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
