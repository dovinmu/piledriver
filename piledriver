        print("Or run: ./tools/setup.sh")
        return 1

    # Build command
    cfg_for_cmd = model_cfg if model_cfg.exists() else None
    cmd = build_tlc_command(tla2tools, model_tla, str(tlc_out), cfg_for_cmd, sany_only)
    if sany_only:
        print(f"Running syntax check on {model_tla.name}...")
    else:
        print(f"Running TLC on {model_tla.name}...")

