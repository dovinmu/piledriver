def cmd_critique(args):
    """Send context to the critic agent and get feedback."""
    session_name = args.session_name
    context = args.context

    piledriver_dir = get_piledriver_root()
    session_dir = piledriver_dir / session_name

    if not session_dir.exists():
        print(f"Error: Session '{session_name}' does not exist.")
        return 1

    state = read_state(session_dir)
    if not state:
        print(f"Error: No state.json found for session '{session_name}'")
        return 1

    current_phase = state.get("current_phase", "UNKNOWN")

    # Load config for critic command
    config = load_config(piledriver_dir)
    critic_command = config.get("critic_command", DEFAULT_CRITIC_COMMAND)

    # Build the full prompt
    full_prompt = CRITIC_PROMPT_TEMPLATE.format(
        phase=current_phase,
        session=session_name,
        context=context
    )

    # Parse the critic command (e.g., "gemini -p" -> ["gemini", "-p"])
    cmd_parts = critic_command.split()
    if not cmd_parts:
        print(f"Error: Invalid critic_command in config: '{critic_command}'")
        return 1

    # Append the prompt as the final argument
    cmd = cmd_parts + [full_prompt]

    print(f"Invoking critic: {cmd_parts[0]}...")
    print("-" * 60)

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=300  # 5 minute timeout
        )
        response = result.stdout.strip()
        if result.stderr:
            response += "\n" + result.stderr.strip()

        if not response:
            print("(No response from critic)")
            return 1

        print(response)

    except subprocess.TimeoutExpired:
        print("Error: Critic timed out after 5 minutes")
        return 1
    except FileNotFoundError:
        print(f"Error: Critic command not found: {cmd_parts[0]}")
        print(f"Configure with: echo 'critic_command: \"your-command\"' >> {piledriver_dir}/config.yaml")
        return 1
    except Exception as e:
        print(f"Error running critic: {e}")
        return 1

    print("-" * 60)

    # Log the exchange
    append_critic_log(session_dir, current_phase, context, response)
    print(f"(Exchange logged to .piledriver/{session_name}/critic_log.jsonl)")

    return 0


